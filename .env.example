NEXTAUTH_URL=https://people.plannorium.com
NEXTAUTH_SECRET=your-nextauth-secret-here
PLANNORIUM_ID_ISSUER=https://id.plannorium.com
PLANNORIUM_ID_CLIENT_ID=
PLANNORIUM_ID_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=plannorium.com
# Work email that becomes the first owner on first sign-in. Required: there is no default owner.
OWNER_EMAIL=
# Optional invite list (comma-separated). When set, ONLY these emails and OWNER_EMAIL can sign in.
# Leave empty to let every verified @ALLOWED_EMAIL_DOMAIN account in.
ACCESS_ALLOWLIST=

# Optional fallback sign-in: Google Workspace accounts on ALLOWED_EMAIL_DOMAIN only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

MONGODB_URI=mongodb+srv://...
# 32 random bytes, base64: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Cloudinary secure storage for employee identification documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_FROM=people@plannorium.com
HR_EMAIL=hr@plannorium.com
# Sends reminder emails via Resend (resend.com). Without it, production reports reminders as not delivered.
RESEND_API_KEY=
# Required: the daily review/retention job refuses to run without it. openssl rand -hex 32
CRON_SECRET=
