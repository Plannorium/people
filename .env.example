NEXTAUTH_URL=https://people.plannorium.com
# Generate a strong session secret locally: openssl rand -base64 32
NEXTAUTH_SECRET=
PLANNORIUM_ID_ISSUER=https://id.plannorium.com
PLANNORIUM_ID_CLIENT_ID=
PLANNORIUM_ID_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=plannorium.com
# Work email that becomes the first owner on first sign-in. Required: there is no default owner.
# Only this exact email can become owner; leave empty until you configure it.
OWNER_EMAIL=
# Exact additional admin emails, comma-separated. Empty means no additional admins.
# Do not put a domain or wildcard here. Stored database roles cannot bypass this list.
ADMIN_EMAILS=
# Passwordless local test login is disabled unless explicitly enabled. Never enable on a shared server.
PEOPLE_ENABLE_DEV_AUTH=false
# Optional invite list (comma-separated). When set, ONLY these emails and OWNER_EMAIL can sign in.
# Leave empty to let every verified @ALLOWED_EMAIL_DOMAIN account in.
ACCESS_ALLOWLIST=

# Optional fallback sign-in: Google Workspace accounts on ALLOWED_EMAIL_DOMAIN only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

MONGODB_URI=mongodb+srv://...
# 32 random bytes, base64: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Cloudinary secure storage for employee identification documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_FROM=team@plannorium.com
# Required for admin verification codes; also sends staff reminders. Admin elevation fails closed without delivery configuration.
RESEND_API_KEY=
# Required: the daily review/retention job refuses to run without it. openssl rand -hex 32
CRON_SECRET=
